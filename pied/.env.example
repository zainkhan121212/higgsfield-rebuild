# Copy to .env.local (development) or set in Vercel → Settings → Environment Variables.
# Never commit real values.

# Prompt → picture (server-only)
FAL_KEY=
# FAL_MODEL=fal-ai/flux/schnell

# Accounts, library, gallery. Supabase: Project → Settings → Database →
# Connection string → "Transaction pooler" (port 6543). Local: npm run db:start.
DATABASE_URL=
# The site's public address; used for links in emails (never the Host header).
APP_URL=http://localhost:3100
# Any long random string; salts the hashed visitor ids in logs.
LOG_SALT=

# Email for verification and password reset (optional; see docs/SECURITY.md)
# RESEND_API_KEY=
# MAIL_FROM=Pied <press@yourdomain.com>

# Spend caps for /api/imagine (defaults shown)
# IMAGINE_PER_10_MIN=8
# IMAGINE_PER_DAY=40
# IMAGINE_SITE_PER_DAY=500
