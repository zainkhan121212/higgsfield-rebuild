generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  BASIC
  PRO
  MAX
}

enum GenKind {
  IMAGE
  VIDEO
}

enum GenStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  handle       String   @unique
  plan         Plan     @default(FREE)
  credits      Int      @default(100)
  createdAt    DateTime @default(now())

  generations Generation[]
  folders     Folder[]
  ledger      CreditEntry[]
}

model Generation {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         GenKind
  modelId      String
  presetId     String?
  prompt       String
  params       Json      @default("{}")
  status       GenStatus @default(QUEUED)
  cost         Int
  outputs      String[]  @default([])
  thumbnailUrl String?
  width        Int?
  height       Int?
  durationSec  Int?
  error        String?
  simulated    Boolean   @default(false)
  isFavorite   Boolean   @default(false)
  isPublic     Boolean   @default(true)
  folderId     String?
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([status])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  generations Generation[]

  @@index([userId])
}

model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
